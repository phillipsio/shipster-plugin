{
  "mcpServers": {
    "shipster": {
      "type": "http",
      "url": "https://mcp.shipster.dev/mcp",
      "headers": {
        "x-api-key": "${user_config.api_token}"
      }
    },
    "repo": {
      "command": "npx",
      "args": [
        "-y",
        "@shipster/cli@latest",
        "mcp"
      ]
    }
  }
}
